{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Ariston NET",
        "description": "Sign in with the account you use in the Ariston NET app. The devices on the account are discovered automatically.",
        "data": {
          "username": "Username",
          "password": "Password",
          "api_url_setting": "API URL",
          "api_user_agent": "API user agent"
        },
        "data_description": {
          "username": "The e-mail address of your Ariston NET account.",
          "password": "The password of your Ariston NET account.",
          "api_url_setting": "Only change this if Ariston moved their API or you use a regional portal.",
          "api_user_agent": "Only change this if the Ariston cloud starts rejecting the default user agent."
        }
      },
      "select": {
        "title": "Choose a device",
        "description": "Several devices were found on this account. Each device becomes its own integration entry; run the setup again to add another one.",
        "data": {
          "select_device": "Device"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate {device}",
        "description": "Ariston rejected the stored credentials for {device}. Enter the current account details.",
        "data": {
          "username": "Username",
          "password": "Password",
          "api_url_setting": "API URL",
          "api_user_agent": "API user agent"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid authentication",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "Device is already configured",
      "no_devices_found": "No devices were found on this Ariston NET account",
      "reauth_successful": "Re-authentication was successful"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling intervals",
        "description": "How often Home Assistant asks the Ariston cloud for new data. Shorter intervals mean fresher values but more cloud requests; Ariston may throttle very frequent polling.",
        "data": {
          "scan_interval": "Device state",
          "energy_scan_interval": "Energy consumption",
          "bus_errors_scan_interval": "Error list"
        },
        "data_description": {
          "scan_interval": "Temperatures, modes, switches and setpoints. Default 180 s.",
          "energy_scan_interval": "Consumption totals and last-month figures. The cloud updates them about once per hour; default 60 min.",
          "bus_errors_scan_interval": "The appliance fault list behind the Problem sensor. Default 600 s."
        }
      }
    }
  },
