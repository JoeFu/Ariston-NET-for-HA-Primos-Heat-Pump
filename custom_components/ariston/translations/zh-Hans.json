  "services": {
    "create_vacation": {
      "name": "Create vacation",
      "description": "Puts the heating system into holiday mode until the given date. Without an end date the current vacation is cancelled.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Ariston device to put on holiday."
        },
        "end_date": {
          "name": "End date",
          "description": "Last day of the vacation. Leave empty to cancel a running vacation."
        }
      }
    },
    "set_item_by_id": {
      "name": "Set property by ID",
      "description": "Writes a raw device or thermostat property. For advanced use; the entities cover the common settings.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Ariston device to write to."
        },
        "item_id": {
          "name": "Property",
          "description": "Ariston property identifier, e.g. ZoneComfortTemp."
        },
        "zone": {
          "name": "Zone",
          "description": "Zone number for thermostat properties; 0 for device-wide properties."
        },
        "value": {
          "name": "Value",
          "description": "The value to write."
        }
      }
    }
